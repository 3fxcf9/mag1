common/header.lib.markup

parser copy_font_directory
	build_html
		lua
		fs_copy('common/static/fonts', 'common/static')
		return ''

copy_font_directory

css
	.header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 3rem;
	}

	.subject-grid {
		display: grid;
		gap: 1em;
		grid-template-columns: repeat(auto-fit, minmax(15em, 1fr));
		grid-auto-flow: row;
	}

	@media screen and (max-width: 700px) {
		.subject-grid {
			grid-template-columns: 1fr;
		}
	}

	.subject {
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--subtext-color);
	}

	.cover {
		height: 5em;
		background-size: cover;
		background-position: center;
		opacity: 0.7;
		transition: opacity 0.1s ease;
	}

	.subject:hover .cover {
		opacity: 1;
	}

	.content {
		padding: 1em;
	}

	.subject-title {
		font-weight: bold;
		font-size: 1.1em;
	}

	.subject-subtitle {
		font-style: italic;
	}


div header
	title Mag1
	date 2026-2027
	print_date

parser subject
	build_html
		lua
		local meta = external_metadata[path_relative_to_toplevel(this.arg .. "/index.markup")]
		local cover_css = "background-color: #aaaaff22"
		local cover_path = path_relative_to_toplevel(this.arg .. "/cover.svg")
		if read_file(cover_path) then
			fs_copy(cover_path, dirname(cover_path))
			cover_css = string.format("background-image: url('%s/cover.svg')", this.arg)
		end
		return string.format([[
			<a class="subject" href="%s">
				<div class="cover" style="%s"></div>
				<div class="content">
					<div class="subject-title">%s</div>
					<div class="subject-teacher">%s</div>
				</div>
			</a>
		]],
		this.arg,
		cover_css,
		(meta.title or {""})[1],
		(meta.teacher or {""})[1])
	list_wrap <div class="subject-grid">$elements</div>

subject math
subject astrophysique
subject electromagnetism
subject meca_analytique
subject meca_quantique
