parser inter_fontface
	head
	build_html
		<style>
			@font-face {
				font-family: "Inter Variable";
				src: url("$http_rootcommon/static/fonts/inter/InterVariable.ttf")
					format("truetype-variations");
				font-weight: 100 900;
				font-display: swap;
				font-style: normal;
			}

			@font-face {
				font-family: "Inter Variable";
				src: url("$http_rootcommon/static/fonts/inter/InterVariable-Italic.ttf")
					format("truetype-variations");
				font-weight: 100 900;
				font-display: swap;
				font-style: italic;
			}
		</style>
inter_fontface

css_file_link static/css/common.css

parser back_link
	build_html
		lua
		if file_path == "index.markup" then return "" else
			local parent = dirname(file_path):gsub("[^/]+$", "index.markup")
			return string.format([[
				<div class="back">
					<a class="back-button" href="..">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-left"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
						%s
					</a>
				</div>
			]], external_metadata[parent].title[1])
		end
