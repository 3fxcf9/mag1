parser edit_on_github
	build_html lua return string.format('<a class="edit-on-github" href="https://github.com/3fxcf9/mag1/blob/main/%s"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>Editer sur github</a>', file_path)

edit_on_github

html
	</aside>
	<main class="right">

html_end
	</main>


parser load_custom_snippets
	end_of_body
	build_html
		lua
		print(path_relative_to_toplevel("snippets.js"))
		local js = read_file(path_relative_to_toplevel("snippets.js"))
		if js ~= nil then
			return '<script>' .. js .. '</script>'
		else
			return ''
		end

load_custom_snippets

