html
	<div class="menu-toggle">
		<svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
		<svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
	</div>
	<aside class="left">

back_link

html
	<nav class="toc-wrapper">

table_of_contents

html
	</nav>
	</aside>
	<main class="right">

html_end
	</main>

parser load_custom_snippets
	end_of_body
	build_html
		lua
		print(path_relative_to_toplevel("snippets.js"))
		local js = read_file(path_relative_to_toplevel("snippets.js"))
		print(string.format("Reading: %s. Content: %s", path_relative_to_toplevel("snippets.js"), js))
		if js ~= nil then
			return '<script>' .. js .. '</script>'
		else
			return ''
		end

load_custom_snippets

js_file_src static/js/math_rendering.js
js_file_src static/js/table_of_contents.js
js_file_src static/js/course.js
js_file_src static/js/figure_zoom.js
